# Copy to .env and fill in real values. Never commit .env.

# GitHub personal access token (classic, public_repo scope) — github.com/settings/tokens
GITHUB_TOKEN=

# MongoDB Atlas connection string — Atlas → Connect → Drivers
MONGODB_URI=

# Google Gemini API key — aistudio.google.com (used from Phase 2 onward)
GEMINI_API_KEY=

# Optional: comma-separated frontend URLs allowed to call the backend (default: the local Vite dev server)
# In production set this to the deployed frontend's URL, e.g. https://your-app.vercel.app
# CORS_ORIGINS=http://localhost:5173

# Secret required by POST /ingest/:repoId, which spends the GitHub token's rate limit.
# Unset means ingestion is refused outright, so a deployment that forgets it fails closed.
# Generate one with:  openssl rand -hex 32
# ADMIN_TOKEN=
