# Copy to .env and fill in real values. Never commit .env.

# GitHub personal access token (classic, public_repo scope) — github.com/settings/tokens
GITHUB_TOKEN=

# MongoDB Atlas connection string — Atlas → Connect → Drivers
MONGODB_URI=

# Google Gemini API key — aistudio.google.com (used from Phase 2 onward)
GEMINI_API_KEY=

# Optional: comma-separated frontend URLs allowed to call the backend (default: the local Vite dev server)
# CORS_ORIGINS=http://localhost:5173
