{
  "name": "codebase-assistant-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/scripts/ingest.ts",
    "embed": "tsx src/scripts/embed.ts",
    "test": "tsx --test $(find src -name \"*.test.ts\")"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
