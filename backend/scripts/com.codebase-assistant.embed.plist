<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.codebase-assistant.embed</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/asawaritajne/codebase-assistant/backend/scripts/daily-embed.sh</string>
    </array>

    <!-- 8am local is comfortably after the Gemini daily quota resets at midnight US Pacific. -->
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/asawaritajne/Library/Logs/codebase-assistant-embed.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/asawaritajne/Library/Logs/codebase-assistant-embed.log</string>
  </dict>
</plist>
